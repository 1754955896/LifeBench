        "exploratory": 0.05,
        "citywide_leisure": 0.04
      },
      "weekend_archetype_weights": {
        "home_recovery": 0.18,
        "local_leisure": 0.22,
        "social_activity": 0.20,
        "exercise_outing": 0.13,
        "exploratory": 0.10,
        "citywide_leisure": 0.12,
        "long_distance": 0.05
      }
    },
    "location_opportunity_pool": {
      "enabled": true,
      "refresh": false,
      "preseed_target_count": 60,
